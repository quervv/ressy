# Copia questo file in .env e compila i valori. Non committare mai .env.

# Token del bot Telegram: crealo con @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=

# Token del bot Discord (facoltativo): Developer Portal → la tua app → Bot → Reset Token.
DISCORD_BOT_TOKEN=
# Link d'invito del bot Discord (facoltativo): mostrato nell'app quando colleghi Discord.
DISCORD_INVITE_URL=

# Indirizzo pubblico del sito, usato nei messaggi del bot.
RESSY_PUBLIC_URL=https://ressy.top
RESSY_TIMEZONE=Europe/Rome

# Secondi di tolleranza prima di avvisare che il PC è offline (evita falsi allarmi su micro-disconnessioni).
RESSY_OFFLINE_GRACE_SECONDS=45
# Tempo massimo di attesa della risposta del PC a un comando.
RESSY_COMMAND_TIMEOUT_SECONDS=150
# Comandi al minuto consentiti per utente.
RESSY_MAX_COMMANDS_PER_MINUTE=20

# Metti 1 se il server sta dietro un reverse proxy (Caddy) che imposta X-Forwarded-For.
RESSY_TRUST_PROXY=0
RESSY_HOST=0.0.0.0
RESSY_PORT=8765
RESSY_DB_PATH=data/ressy.db

LOG_LEVEL=INFO
